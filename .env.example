# ─────────────────────────────────────────────────────────────
# ProofOfSkill — Environment Variables Configuration
# ─────────────────────────────────────────────────────────────

# ── Frontend Client (Vite) ───────────────────────────────────
# Public URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key for client requests (RLS-enforced)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Demo / Preview Mode:
# - 'true': Enables role switcher bar at top and offline IndexedDB preview mode
# - 'false': Production mode (authenticated Supabase session required)
VITE_DEMO_MODE=true

# ── Supabase Edge Functions (Managed in Supabase Vault / Secrets) ──
# Note: The following secrets are configured via `supabase secrets set`
# and are NOT prefixed with VITE_ (they must never be exposed to the client).
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (Used by score-submission to write authoritative scores)
# CERTIFICATE_SIGNING_SECRET=your-random-hmac-secret-string (Used by generate-certificate)
# ANTHROPIC_API_KEY=sk-ant-api... (Optional: for Claude coaching narrative feedback)
